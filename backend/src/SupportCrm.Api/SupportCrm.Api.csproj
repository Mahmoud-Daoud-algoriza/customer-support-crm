<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SupportCrm.Application\SupportCrm.Application.csproj" />
    <ProjectReference Include="..\SupportCrm.Infrastructure\SupportCrm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test host reproduces SlaMonitorHostedService's scope setup, which needs
         CurrentUserAccessor.SetSystem (Story 09). Exposing internals to the test assembly is
         narrower than making the system identity public: no production caller outside this assembly
         can install it, which is the property that makes it safe. -->
    <InternalsVisibleTo Include="SupportCrm.Tests" />
  </ItemGroup>
</Project>
