# Copy to .env and fill in. .env is git-ignored — no credential is ever committed
# (docs/architecture.md §6.3, secrets discipline).

# SQL Server requires at least 8 characters with upper case, lower case, and a digit or symbol.
MSSQL_SA_PASSWORD=

# Reserved for Story 02 (authentication). Any long random string; unused until then.
SUPPORTCRM_JWT_KEY=
